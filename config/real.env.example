# Copy these assignments into the shell used for a real run.
# This file intentionally contains no credentials or Kaggle tokens.

# Python that has this project plus the selected candidate dependencies.
# The control runner resolves ${PYTHON} to the active interpreter.
PYTHON=.venv-biohub/bin/python
KAGGLE_CONFIG_DIR=.kaggle

# Public baseline checkout and its optional external Python executable.
CELL_TRACKING_ROOT=external/kaggle-cell-tracking-competition
CELL_TRACKING_PYTHON=.venv-biohub/bin/python
STARDIST_PYTHON=.venv-stardist/bin/python

# Final artifact and validation data.
TEST_DATA_DIR=/absolute/path/to/data/test
DATA_DIR=/absolute/path/to/data/train_split
HOLDOUT_DATA_DIR=/absolute/path/to/data/holdout

# Optional H3 Ultrack labels, with the same dataset stems as the image dirs.
# These are segmentation candidates, not ground-truth files.
ULTRACK_LABELS_DIR=/absolute/path/to/labels/test
ULTRACK_VALIDATION_LABELS_DIR=/absolute/path/to/labels/train_split
ULTRACK_HOLDOUT_LABELS_DIR=/absolute/path/to/labels/holdout

# Keep this at the verified competition limit; the local ledger is UTC.
KAGGLE_DAILY_SUBMISSION_LIMIT=5
# Set to subset for diagnostics; only full permits live eligibility.
BIOHUB_DATA_SCOPE=full
