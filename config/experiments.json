      "name": "smoke_baseline",
      "family": "smoke",
      "enabled": true,
      "live_eligible": false,
      "command": [
        "${PYTHON}",
        "-m",
        "biohub_lab.demo_candidate",
        "--run-dir",
        "${RUN_DIR}",
        "--variant",
        "baseline"
      ],
      "hypothesis": "O contrato do artefato e o loop de ranking são reproduzíveis.",
