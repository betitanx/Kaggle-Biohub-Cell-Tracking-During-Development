{
  "competition": "biohub-cell-tracking-during-development",
  "submission_mode": "notebook",
  "notebook_payload_mode": "runner",
  "notebook_enable_gpu": true,
  "notebook_machine_shape": "NvidiaTeslaT4",
  "notebook_dataset": "your-kaggle-user/biohub-cell-candidates",
  "daily_submission_limit": 5,
  "max_submissions_per_cycle": 2,
  "expected_timepoints": 100,
  "expected_datasets": [
    "44b6_0113de3b",
    "44b6_0b24845f",
    "6bba_05b6850b",
    "6bba_05db0fb1"
  ],
  "default_timeout_seconds": 14400,
  "adaptive": {
    "enabled": false,
    "max_proposals_per_cycle": 0
  },
  "experiments": [
    {
      "name": "cellmot_metric_probe",
      "family": "metric_probe",
      "enabled": false,
      "live_eligible": false,
      "command": [
        "${CELL_TRACKING_PYTHON}",
        "-m",
        "biohub_lab.cellmot_candidate",
        "--baseline-root",
        "${CELL_TRACKING_ROOT}",
        "--data-dir",
        "${TEST_DATA_DIR}",
        "--run-dir",
        "${RUN_DIR}",
        "--validation-data-dir",
        "${DATA_DIR}",
        "--evaluate-gt-dir",
        "${DATA_DIR}",
        "--holdout-data-dir",
        "${HOLDOUT_DATA_DIR}",
        "--holdout-gt-dir",
        "${HOLDOUT_DATA_DIR}",
        "--split",
        "0",
        "--method",
        "unet_transformer",
        "--support-pack-dir",
        "${BIOHUB_SUPPORT_PACK_DIR}",
        "--det-threshold",
        "0.9675",
        "--edge-threshold",
        "0.5",
        "--pool-kernel-um",
        "3.0",
        "--ilp-appearance-weight",
        "0.0",
        "--ilp-disappearance-weight",
        "1.4",
        "--ilp-division-weight",
        "1.0",
        "--use-ilp"
      ],
      "notebook_runner_kind": "support_pack_metric_probe",
      "notebook_runner_det_threshold": 0.9675,
      "notebook_runner_options": {
        "det_threshold": 0.9675,
        "edge_threshold": 0.5,
        "ilp_appearance_weight": 0.0,
        "ilp_disappearance_weight": 1.4,
        "ilp_division_weight": 1.0,
        "pool_kernel_um": 3.0,
        "gap_closing": true,
        "gap_closing_max_total_distance_um": 10.0,
        "gap_closing_reuse_existing_um": 2.5,
        "gap_closing_max_added_fraction": 0.02,
        "gap_closing_max_added_absolute": 1000,
        "metric_probe": true,
        "metric_probe_max_components": 1400,
        "metric_probe_forks": 5
      },
      "notebook_expected_timepoints": 100,
      "notebook_additional_dataset_sources": [
        "pilkwang/biohub-tracking-support-pack-50ep-v1",
        "yoikoarmor/biohub-last-call-postprocess-v1"
      ],
      "hypothesis": "O pós-processamento público com hub/forks negativos altera o scorer da competição; deve ser testado apenas como probe separada da hipótese biológica.",
      "tags": [
        "metric-probe",
        "public-top-lead",
        "scorer-specific",
        "support-pack"
      ],
      "expected_minutes": 120,
      "timeout_seconds": 14400,
      "requires": [
        "CELL_TRACKING_PYTHON",
        "CELL_TRACKING_ROOT",
        "BIOHUB_SUPPORT_PACK_DIR",
        "TEST_DATA_DIR",
        "DATA_DIR",
        "HOLDOUT_DATA_DIR"
      ],
      "variants": [
        {
          "name": "v5_threshold_9675",
          "args": [],
          "overrides": {
            "notebook_runner_options": {
              "det_threshold": 0.9675,
              "edge_threshold": 0.5,
              "ilp_appearance_weight": 0.0,
              "ilp_disappearance_weight": 1.4,
              "ilp_division_weight": 1.0,
              "pool_kernel_um": 3.0,
              "gap_closing": true,
              "gap_closing_max_total_distance_um": 10.0,
              "gap_closing_reuse_existing_um": 2.5,
              "gap_closing_max_added_fraction": 0.02,
              "gap_closing_max_added_absolute": 1000,
              "metric_probe": true,
              "metric_probe_max_components": 1400,
              "metric_probe_forks": 5
            }
          }
        },
        {
          "name": "v7_edge_048",
          "args": [
            "--det-threshold",
            "0.965",
            "--edge-threshold",
            "0.48",
            "--max-eval-distance",
            "7.0"
          ],
          "overrides": {
            "notebook_runner_det_threshold": 0.965,
            "notebook_runner_options": {
              "det_threshold": 0.965,
              "edge_threshold": 0.48,
              "ilp_appearance_weight": 0.0,
              "ilp_disappearance_weight": 1.4,
              "ilp_division_weight": 1.0,
              "pool_kernel_um": 3.0,
              "gap_closing": true,
              "gap_closing_max_total_distance_um": 10.0,
              "gap_closing_reuse_existing_um": 2.5,
              "gap_closing_max_added_fraction": 0.02,
              "gap_closing_max_added_absolute": 1000,
              "metric_probe": true,
              "metric_probe_max_components": 1400,
              "metric_probe_forks": 5
            }
          }
        }
      ]
    }
  ],
  "require_all_candidates": true
}
